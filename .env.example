APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
UPLOAD_ALLOW_LEGACY_PUBLIC_FILES=false
FORCE_HTTPS=false
SECURITY_HSTS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Progressive login protection and MainAdmin email verification
LOGIN_CAPTCHA_AFTER=3
LOGIN_LOCKOUT_AFTER=5
LOGIN_LOCKOUT_SECONDS=900
LOGIN_CAPTCHA_LIFETIME_SECONDS=300

# reCAPTCHA v3 setup guide:
# - The label (for example, "ClearanceMS Local") belongs only in Google's console.
# - For localhost with internet, use a development key that allows the localhost domain.
# - For production, use a separate key that allows the real website hostname.
# - reCAPTCHA cannot work without internet; keep RECAPTCHA_ENABLED=false when offline.
# - Never commit the secret key. Put real keys only in the server's private .env file.
WEB_RATE_LIMIT_PER_MINUTE=100
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MINIMUM_SCORE=0.5
ADMIN_LOGIN_OTP_LIFETIME_SECONDS=600
ADMIN_LOGIN_OTP_MAX_ATTEMPTS=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_ENABLED=false
BACKUP_DISK=local
BACKUP_PATH=system-backups
# BACKUP_DATABASE_CONNECTION=sqlite
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_MYSQLDUMP_TIMEOUT=900
BACKUP_MYSQL_NO_TABLESPACES=true
BACKUP_INCLUDE_PUBLIC_STORAGE=true
BACKUP_ARCHIVE_PASSWORD=
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_SCHEDULE_TIME=02:00
BACKUP_SCHEDULE_TIMEZONE=UTC
BACKUP_OVERLAP_TIMEOUT=180
BACKUP_ON_ONE_SERVER=false

# Optional: override the Android APK served from the student sidebar.
STUDENT_APP_APK_PATH=
STUDENT_APP_DOWNLOAD_NAME=MCC-e-Clearance-Student.apk

VITE_APP_NAME="${APP_NAME}"
